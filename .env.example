PORT=3000

# ZonaEpic
ZONAEPIC_BASE_URL=https://admin.zonaepic.vip
ZONAEPIC_PHPSESSID=tu_php_session_id
ZONAEPIC_TOKEN=
ZONAEPIC_USERNAME=Pelopelo123
ZONAEPIC_PAGE_SIZE=100
ZONAEPIC_LOOKBACK_DAYS=30
ZONAEPIC_FULL_IMPORT_START=2025-01-01
ZONAEPIC_MAX_ROWS=20000
ZONAEPIC_WINDOW_MAX_ROWS=20000
ZONAEPIC_START_DATE=
ZONAEPIC_END_DATE=
ZONAEPIC_START_TIME=00:00:00
ZONAEPIC_END_TIME=00:00:00
# Cuanto tiempo (ms) se reutiliza el token CSRF ya obtenido antes de volver a
# pedirlo a report_balances.php (evita cientos de requests redundantes durante
# la importacion historica inicial, que hace un pedido por dia).
ZONAEPIC_TOKEN_CACHE_TTL_MS=45000

# Zeus
ZEUS_BASE_URL=https://admin.casinozeus.tech
ZEUS_USERNAME=
ZEUS_PASSWORD=
ZEUS_PAGE_SIZE=30
ZEUS_LOOKBACK_DAYS=30

# Directorio de contactos (.vcf locales en data/contacts)
# Cuanto tiempo (ms) se reutiliza el listado ya escaneado antes de volver a
# leer el disco (evita hacer readdir/stat en cada snapshot de Zeus, que puede
# repetirse cada ~15s).
CONTACTS_DIRECTORY_CHECK_TTL_MS=30000
